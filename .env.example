# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=
PORT=5000
NODE_ENV=development

# Required for any admin write (sports/bookmakers/events/odds CRUD, seed,
# opportunity scans, real-odds/results ingestion). Generate a long random
# value, e.g.: openssl rand -base64 32
ADMIN_API_KEY=

# Optional — set to allow The-Odds-API ingestion (/fetch-real-odds,
# /fetch-results). Without it those routes 400 with a clear message.
ODDS_API_KEY=

# Optional — comma-separated The-Odds-API sport_keys to ingest (e.g.
# "soccer_epl,soccer_spain_la_liga"). Leave unset to use the curated default
# list of ~15 major leagues in routes/real-odds.ts. Each key queried costs
# API quota on every ingestion run — check your The-Odds-API plan's quota
# before adding many more.
ODDS_API_SPORT_KEYS=

# Optional — comma-separated list of extra browser origins allowed to call
# this API cross-origin (the app's own frontend is same-origin and never
# needs this). Leave unset unless another site legitimately calls the API.
CORS_ORIGINS=

# Required in production for the scheduled ingestion cron (see vercel.json's
# "crons") to authenticate — set this as a Vercel project env var and Vercel
# automatically sends it as `Authorization: Bearer <CRON_SECRET>` on cron
# invocations. Also accepted via a legacy `x-cron-secret` header for any
# non-Vercel scheduler. Falls back to requiring ADMIN_API_KEY if unset.
CRON_SECRET=
