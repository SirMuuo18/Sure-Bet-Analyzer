# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=
PORT=5000
NODE_ENV=development

# Required for any admin write (sports/bookmakers/events/odds CRUD, seed,
# opportunity scans, real-odds/results ingestion). Generate a long random
# value, e.g.: openssl rand -base64 32
ADMIN_API_KEY=

# Optional — set to allow The-Odds-API ingestion (/fetch-real-odds,
# /fetch-results). Without it those routes 400 with a clear message.
ODDS_API_KEY=

# Optional — comma-separated list of extra browser origins allowed to call
# this API cross-origin (the app's own frontend is same-origin and never
# needs this). Leave unset unless another site legitimately calls the API.
CORS_ORIGINS=

# Optional — a separate secret for server-to-server ingestion calls (e.g. a
# future scheduled job) via the `x-cron-secret` header, so a cron provider
# never needs the admin key. Falls back to ADMIN_API_KEY if unset.
CRON_SECRET=
